# SVN contract address on Robinhood Chain. Leave empty until launch.
# Once set, the terminal fetches the SVN price and the ratio goes live.
NEXT_PUBLIC_SVN_CA=0xdb270100A5C9D68dB8d49AC7861D2BB7c35138Af

# Where the "Buy $SVN" buttons point. Leave empty to scroll to the token section.
NEXT_PUBLIC_SVN_BUY_URL=

# Optional: your own Robinhood Chain RPC (the public one is rate limited).
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: gold reserve in troy ounces. Leave empty to show "Not published".
NEXT_PUBLIC_RESERVE_XAU=

# Optional: video used as hero and blurred page background.
NEXT_PUBLIC_HERO_VIDEO=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260815_034306_229eccbe-fd8f-40fb-8002-9868ef2bb1a8.mp4

# Vault milestones in USD. Reaching either one unlocks the vault. Leave empty until announced.
NEXT_PUBLIC_TARGET_MCAP=
NEXT_PUBLIC_TARGET_VOLUME=